<?xml version="1.0"?>
<ruleset name="MelisCore PHP compatibility">
    <description>PHP 8.3 to 8.5 compatibility checks for melis-core. Vendored third-party assets are excluded.</description>

    <!-- Paths that contain melis-authored PHP -->
    <file>src</file>
    <file>config</file>
    <file>view</file>
    <file>install</file>
    <file>language</file>
    <file>public</file>

    <arg name="extensions" value="php,phtml"/>
    <arg name="colors"/>
    <arg value="p"/>

    <!-- Third-party / vendored code shipped under public/ is not fixed by this ruleset -->
    <exclude-pattern>*/public/js/filemanager/*</exclude-pattern>
    <exclude-pattern>*/public/js/library/*</exclude-pattern>
    <exclude-pattern>*/public/assets/*</exclude-pattern>

    <!-- Target the supported PHP range -->
    <config name="testVersion" value="8.3-"/>

    <rule ref="PHPCompatibility"/>
</ruleset>
