<?php
    $loginClas = (int) $this->isLogin == 1 ? 'login-page' : '';
    $schemes = $this->layout()->schemes;
    $loginBackground = $this->login_background;
    $favicon = '/favicon.ico';

    // SECURITY (audit H4) : valeurs du Platform Scheme (stockées en DB, éditables depuis l'outil
    // Scheme) injectées dans ce layout — y compris sur la page de LOGIN, pré-authentification.
    // $loginBackground part dans un contexte CSS url() où l'échappement HTML ne protège pas :
    // allowlist de caractères d'URL (chemins relatifs, http(s), data:image) — valeur hostile
    // ignorée, on garde le défaut.
    $isSafeSchemeUrl = static function ($url) {
        // Délimiteurs {} : la classe contient un # littéral (fragment d'URL).
        return (bool) preg_match('{^[A-Za-z0-9/._:%#?&=~+;,\-]+$}', (string) $url);
    };

    if ($schemes) {
        if (!empty($schemes->getLoginBackground()) && $isSafeSchemeUrl($schemes->getLoginBackground())) {
            $loginBackground = $schemes->getLoginBackground();
        }

        if (!empty($schemes->getFavicon()) && $isSafeSchemeUrl($schemes->getFavicon())) {
            $favicon = $schemes->getFavicon();
        }
    }
    // Le défaut du contrôleur transite aussi par le CSS : même garde.
    if (!$isSafeSchemeUrl($loginBackground)) {
        $loginBackground = '';
    }

    $bundle = $this->layout()->bundle;

    if ($this->layout()->isLogin) {
        $bundle = $this->MelisCoreHeadPlugin('/meliscore_login', $this->layout()->buildBundle);
    }

    echo $this->doctype();
?>
