<?php
/**
 * Web-services (microservices) listing — standalone page styled to MATCH the React back-office
 * palette (brand red), but this is a PURE server-rendered legacy Laminas view: no React, no Vite,
 * no build step and no external assets — inline CSS/SVG/vanilla-JS only, system-font fallbacks.
 * It therefore runs on any deployment (incl. existing projects without the node/Vite tooling).
 * Rendered terminal (no legacy layout). Grouped by Melis module.
 */
$esc     = function ($v) { return $this->escapeHtml((string) $v); };
$escAttr = function ($v) { return $this->escapeHtmlAttr((string) $v); };
$escUrl  = function ($v) { return $this->escapeUrl((string) $v); };

$apiKey  = $this->apiKey;
$modules = $this->userExists && is_array($this->microservice) ? $this->microservice : array();

// Totals
$totalModules   = 0;
$totalServices  = 0;
$totalEndpoints = 0;
foreach ($modules as $svcs) {
    if (!is_array($svcs)) { continue; }
    $mEnd = 0;
    foreach ($svcs as $methods) {
        if (is_array($methods)) { $mEnd += count($methods); }
    }
    if ($mEnd === 0) { continue; } // skip modules that expose no endpoint
    $totalModules++;
    $totalServices += count($svcs);
    $totalEndpoints += $mEnd;
}
