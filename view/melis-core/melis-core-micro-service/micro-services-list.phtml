  <script>
    // Localized strings for JS-set labels (translated server-side via the Melis translator).
    var WS_I18N = {
      copy:   <?php echo json_encode($this->translate('tr_meliscore_ws_copy')); ?>,
      copied: <?php echo json_encode($this->translate('tr_meliscore_ws_copied')); ?>
    };
    var _copyTimer = null;
    function copyKey(btn){
      var t = document.getElementById('apikey').textContent.trim();
      var done = function(){
        btn = btn || document.getElementById('copyBtn');
        if (!btn) { return; }
        btn.classList.add('copied');
        btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>' + WS_I18N.copied;
        clearTimeout(_copyTimer);
        _copyTimer = setTimeout(function(){ btn.classList.remove('copied'); btn.textContent = WS_I18N.copy; }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(t).then(done).catch(done);
      } else {
        // Fallback for non-secure contexts
        var ta = document.createElement('textarea');
        ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        done();
      }
    }
    var activeSection = null;

    function resetMethods(mod){
      mod.querySelectorAll('.method').forEach(function(m){ m.style.display = ''; });
      mod.querySelectorAll('.service').forEach(function(s){ s.style.display = ''; });
    }

    // Show only the cards of the active section (default view — one section at a time).
    function applyActiveSection(){
      var any = false;
      document.querySelectorAll('#grid .module').forEach(function(mod){
        var show = mod.getAttribute('data-section') === activeSection;
        mod.style.display = show ? '' : 'none';
        if (show) { resetMethods(mod); any = true; }
      });
      document.getElementById('noresult').style.display = any ? 'none' : 'block';
    }

    function selectSection(sk){
      activeSection = sk;
      var f = document.getElementById('filter'); if (f) f.value = '';
      document.querySelectorAll('.sb-sec').forEach(function(sec){
        sec.classList.toggle('sel', sec.getAttribute('data-sec') === sk);
      });
      document.querySelectorAll('.sb-item').forEach(function(a){ a.style.display = ''; a.classList.remove('active'); });
      applyActiveSection();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Sidebar module click → make sure its section is active, then scroll to its card.
    function gotoModule(mod){
      var el = document.getElementById('mod-' + mod);
      var sk = el ? el.getAttribute('data-section') : null;
      if (sk && sk !== activeSection) { selectSection(sk); el = document.getElementById('mod-' + mod); }
      if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      document.querySelectorAll('.sb-item.active').forEach(function(x){ x.classList.remove('active'); });
      var it = document.querySelector('.sb-item[data-mod="' + mod + '"]'); if (it) it.classList.add('active');
    }

    // Search spans EVERYTHING (all sections, every service & method); clearing it returns to the
    // active-section view.
    function filterList(){
      var q = document.getElementById('filter').value.trim().toLowerCase();
      if (!q) {
        document.querySelectorAll('.sb-item').forEach(function(a){ a.style.display = ''; });
        applyActiveSection();
        return;
      }
      var anyModule = false;
      document.querySelectorAll('#grid .module').forEach(function(mod){
        var anyMethod = false;
        mod.querySelectorAll('.method').forEach(function(m){
          var show = m.getAttribute('data-search').indexOf(q) !== -1
                     || mod.getAttribute('data-search').indexOf(q) !== -1;
          m.style.display = show ? '' : 'none';
          if (show) anyMethod = true;
        });
        mod.querySelectorAll('.service').forEach(function(s){
          var vis = Array.prototype.some.call(s.querySelectorAll('.method'), function(m){ return m.style.display !== 'none'; });
          s.style.display = vis ? '' : 'none';
        });
        mod.style.display = anyMethod ? '' : 'none';
        if (anyMethod) anyModule = true;
      });
      document.querySelectorAll('.sb-item').forEach(function(a){
        var mod = document.getElementById('mod-' + a.getAttribute('data-mod'));
        a.style.display = (mod && mod.style.display !== 'none') ? '' : 'none';
      });
      document.getElementById('noresult').style.display = anyModule ? 'none' : 'block';
    }

    // Wire sidebar module items + select the first section on load.
    document.querySelectorAll('.sb-item').forEach(function(a){
      a.addEventListener('click', function(e){ e.preventDefault(); gotoModule(a.getAttribute('data-mod')); });
    });
    (function(){
      var first = document.querySelector('.sb-sec');
      if (first) { selectSection(first.getAttribute('data-sec')); }
    })();
  </script>
<?php } ?>
</body>
</html>
