          <div class="name">MELIS<small>Web Services</small></div>
        </div>
        <div class="spacer"></div>
        <div class="keychip">
          <span class="lbl">API key</span>
          <code id="apikey"><?php echo $esc($apiKey); ?></code>
          <button type="button" onclick="copyKey()">Copy</button>
        </div>
      </div>
      <h1><?php echo $esc($this->translate($this->title)); ?></h1>
      <p>Token-authenticated JSON API. Each endpoint is called with <b>POST</b>; open one to try it with a form. All responses are JSON.</p>
      <div class="stats">
        <div class="stat"><b><?php echo (int) $totalModules; ?></b><span>Modules</span></div>
        <div class="stat"><b><?php echo (int) $totalServices; ?></b><span>Services</span></div>
        <div class="stat"><b><?php echo (int) $totalEndpoints; ?></b><span>Endpoints</span></div>
      </div>
    </div>
  </div>

  <div class="toolbar">
    <div class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="filter" type="text" placeholder="Filter endpoints, services or modules…" oninput="filterList()" autocomplete="off">
    </div>
  </div>

  <div class="grid" id="grid">
  <?php foreach ($modules as $module => $services) {
        if (!is_array($services)) { continue; }
        $mCount = 0; foreach ($services as $mm) { if (is_array($mm)) { $mCount += count($mm); } }
        if ($mCount === 0) { continue; } // don't render empty modules ?>
    <section class="module" data-search="<?php echo $escAttr(strtolower($module)); ?>">
      <div class="m-head">
        <span class="m-dot"></span>
        <span class="m-name"><?php echo $esc($module); ?></span>
        <span class="m-count"><?php echo (int) $mCount; ?> endpoint<?php echo $mCount > 1 ? 's' : ''; ?></span>
      </div>
      <div class="m-body">
      <?php foreach ($services as $serviceName => $methods) {
            if (!is_array($methods)) { continue; } ?>
        <div class="service">
          <div class="s-name">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12h8M8 8h8M8 16h5"/></svg>
            <?php echo $esc($serviceName); ?>
          </div>
          <div class="methods">
          <?php foreach ($methods as $methodName => $config) {
                // Each segment is rawurlencode'd (no HTML-special chars left), so the assembled
                // same-origin path is safe to print as-is — escaping the whole path would turn the
                // slashes into &#x2F; and the router would 404.
                $url = '/melis/api/' . rawurlencode($apiKey) . '/' . rawurlencode($module) . '/service/' . rawurlencode($serviceName) . '/' . rawurlencode($methodName);
                $hay = strtolower($module . ' ' . $serviceName . ' ' . $methodName); ?>
            <a class="method" href="<?php echo $url; ?>" target="_blank" rel="noopener" data-search="<?php echo $escAttr($hay); ?>">
              <span class="verb">POST</span>
              <span class="mname"><?php echo $esc($methodName); ?></span>
              <span class="path mono"><?php echo $esc($serviceName); ?></span>
              <span class="go">Try it
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          <?php } ?>
          </div>
        </div>
      <?php } ?>
      </div>
    </section>
  <?php } ?>
    <div class="noresult" id="noresult">No endpoint matches your search.</div>
  </div>

  <footer>Melis Platform · Web Services — this page lists the endpoints available for your API key.</footer>

  <script>
    function copyKey(){
      var t = document.getElementById('apikey').textContent.trim();
      if (navigator.clipboard) navigator.clipboard.writeText(t);
    }
    function filterList(){
      var q = document.getElementById('filter').value.trim().toLowerCase();
      var anyModule = false;
      document.querySelectorAll('#grid .module').forEach(function(mod){
        var anyMethod = false;
        mod.querySelectorAll('.method').forEach(function(m){
          var show = !q || m.getAttribute('data-search').indexOf(q) !== -1
                     || mod.getAttribute('data-search').indexOf(q) !== -1;
          m.style.display = show ? '' : 'none';
          if (show) anyMethod = true;
        });
        // hide services with no visible methods
        mod.querySelectorAll('.service').forEach(function(s){
          var vis = Array.prototype.some.call(s.querySelectorAll('.method'), function(m){ return m.style.display !== 'none'; });
          s.style.display = vis ? '' : 'none';
        });
        mod.style.display = anyMethod ? '' : 'none';
        if (anyMethod) anyModule = true;
      });
      document.getElementById('noresult').style.display = anyModule ? 'none' : 'block';
    }
  </script>
<?php } ?>
