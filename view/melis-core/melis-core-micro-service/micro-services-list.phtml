<?php
/**
 * Web-services (microservices) listing — standalone page styled to MATCH the React back-office
 * palette (brand red), but this is a PURE server-rendered legacy Laminas view: no React, no Vite,
 * no build step and no external assets — inline CSS/SVG/vanilla-JS only, system-font fallbacks.
 * It therefore runs on any deployment (incl. existing projects without the node/Vite tooling).
 * Rendered terminal (no legacy layout).
 *
 * Left sidebar lists the modules that expose endpoints, grouped by Melis section (like the BO
 * left menu). The section of a module is derived from its name/family (Core, CMS, Commerce,
 * Marketing, AI, …) so the grouping stays correct as new modules gain web-services.
 */
$esc     = function ($v) { return $this->escapeHtml((string) $v); };
$escAttr = function ($v) { return $this->escapeHtmlAttr((string) $v); };

$apiKey  = $this->apiKey;
$modules = $this->userExists && is_array($this->microservice) ? $this->microservice : array();
// module => `*_toolstree_section` key, computed controller-side from each module's app.interface.php.
$moduleSections = is_array($this->moduleSections) ? $this->moduleSections : array();

// --- The BO left-menu sections (same keys, order, colours and icon as the classic left menu). ---
// `icon` is the name of the Melis view helper that renders the section's inline-SVG tile (identical
// to the back-office); `color` is the official section colour taken from those helpers.
$sectionDefs = array(
    'meliscore_toolstree_section'        => array('label' => 'MelisCore',        'color' => '#ee6622', 'icon' => 'melisCoreIcon'),
    'meliscms_toolstree_section'         => array('label' => 'MelisCMS',         'color' => '#69b344', 'icon' => 'melisCmsIcon'),
    'melismarketing_toolstree_section'   => array('label' => 'MelisMarketing',   'color' => '#70469c', 'icon' => 'melisMarketingIcon'),
    'meliscommerce_toolstree_section'    => array('label' => 'MelisCommerce',    'color' => '#2780c4', 'icon' => 'melisCommerceIcon'),
    'melisothers_toolstree_section'      => array('label' => 'MelisOthers',      'color' => '#ff0000', 'icon' => 'melisOthersIcon'),
    'meliscustom_toolstree_section'      => array('label' => 'MelisCustom',      'color' => '#676767', 'icon' => 'melisCustomIcon'),
    'melismarketplace_toolstree_section' => array('label' => 'MelisMarketplace', 'color' => '#ff0000', 'icon' => 'melisOthersIcon'),
);
$sectionOf = function ($module) use ($moduleSections, $sectionDefs) {
    $sk = isset($moduleSections[$module]) ? $moduleSections[$module] : 'meliscore_toolstree_section';
    if (!isset($sectionDefs[$sk])) { $sk = 'melisothers_toolstree_section'; }
    return $sk;
};

// --- Group modules (that expose at least one endpoint) by section ------------------------------
// Count real endpoints in a service config, ignoring reserved meta keys (e.g. '_description').
$countEndpoints = function ($methods) {
    $n = 0;
    if (is_array($methods)) {
        foreach ($methods as $mName => $mCfg) {
            if (is_array($mCfg) && (string) $mName !== '' && $mName[0] !== '_') { $n++; }
        }
    }
    return $n;
};

$grouped        = array();   // sectionKey => array(module => endpointCount)
$totalModules   = 0;
$totalServices  = 0;
$totalEndpoints = 0;
foreach ($modules as $module => $services) {
    if (!is_array($services)) { continue; }
    $mEnd = 0;
    foreach ($services as $methods) {
        $mEnd += $countEndpoints($methods);
    }
    if ($mEnd === 0) { continue; } // skip modules that expose no endpoint
    $totalModules++;
    $totalServices  += count($services);
    $totalEndpoints += $mEnd;
    $grouped[$sectionOf($module)][$module] = $mEnd;
}

// Ordered flat list of modules (section order, then alphabetical) — the grid follows this order
// so scrolling matches the sidebar.
$orderedModules = array();
foreach ($sectionDefs as $sk => $def) {
    if (empty($grouped[$sk])) { continue; }
    ksort($grouped[$sk]);
    foreach ($grouped[$sk] as $module => $cnt) { $orderedModules[] = $module; }
}
