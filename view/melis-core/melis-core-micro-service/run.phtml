  <script>
    // Localized status labels (translated server-side via the Melis translator).
    var WS_I18N = {
      success:    <?php echo json_encode($this->translate('tr_meliscore_ws_pill_success')); ?>,
      validation: <?php echo json_encode($this->translate('tr_meliscore_ws_pill_validation')); ?>,
      error:      <?php echo json_encode($this->translate('tr_meliscore_ws_pill_error')); ?>,
      nonjson:    <?php echo json_encode($this->translate('tr_meliscore_ws_pill_nonjson')); ?>,
      network:    <?php echo json_encode($this->translate('tr_meliscore_ws_pill_network')); ?>
    };
    (function(){
      var form = document.getElementById('microservice_form');
      if(!form) return;
      var card = document.getElementById('resultCard'),
          pill = document.getElementById('resPill'),
          body = document.getElementById('resBody');

      function esc(s){return String(s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
      function highlight(json){
        return esc(json).replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(\.\d+)?([eE][+\-]?\d+)?)/g,function(m){
          var cls='n'; if(/^"/.test(m)){cls=/:$/.test(m)?'k':'s';} else if(/true|false|null/.test(m)){cls='b';}
          return '<span class="'+cls+'">'+m+'</span>';
        });
      }
      form.addEventListener('submit', function(e){
        e.preventDefault();
        card.classList.add('show');
        pill.className='pill'; pill.textContent='';
        body.innerHTML='<span class="spin"></span>';
        card.scrollIntoView({behavior:'smooth', block:'nearest'});
        fetch(form.action, {method:'POST', body:new FormData(form), headers:{'X-Requested-With':'XMLHttpRequest'}})
          .then(function(r){return r.text();})
          .then(function(t){
            try{
              var d=JSON.parse(t);
              var ok = d && d.success;
              pill.className='pill '+(ok?'ok':'ko');
              pill.textContent = ok ? WS_I18N.success : (d && d.errors && Object.keys(d.errors).length ? WS_I18N.validation : WS_I18N.error);
              body.innerHTML = highlight(JSON.stringify(d, null, 2));
            }catch(err){
              pill.className='pill ko'; pill.textContent=WS_I18N.nonjson;
              body.textContent = t.slice(0, 4000);
            }
          })
          .catch(function(err){ pill.className='pill ko'; pill.textContent=WS_I18N.network; body.textContent=String(err); });
      });
    })();
  </script>
