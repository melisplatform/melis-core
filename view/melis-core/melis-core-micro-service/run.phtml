<?php
/**
 * Web-service method "try it" page — standalone, styled to match the React back-office palette
 * (brand red). PURE server-rendered legacy Laminas view: no React, no Vite, no build, no external
 * assets — inline CSS/SVG/vanilla-JS only. Runs on any deployment. Rendered terminal (no layout).
 */
$esc     = function ($v) { return $this->escapeHtml((string) $v); };
$escAttr = function ($v) { return $this->escapeHtmlAttr((string) $v); };

$form        = $this->form;
$methodName  = (string) $this->methodName;
$module      = (string) $this->module;
$serviceName = (string) $this->serviceName;
$apiKey      = (string) $this->apiKey;
$backUrl     = '/melis/api/' . rawurlencode($apiKey);
$endpointUrl = $backUrl . '/' . rawurlencode($module) . '/service/' . rawurlencode($serviceName) . '/' . rawurlencode($methodName);

// Append the argument data-type to each label (e.g. "idPage (int)"), like before.
foreach ($form->getElements() as $element => $attributes) {
    $el = $form->get((string) $element);
    $attrs = $el->getAttributes();
    if ($attrs && isset($attrs['data-type'])) {
        $el->setLabel($el->getLabel() . ' (' . $this->translate($attrs['data-type']) . ')');
    }
}
